# Template elaborato da /docker-entrypoint.d/20-envsubst-on-templates.sh
# → /etc/nginx/conf.d/proxy.conf. envsubst sostituisce solo le variabili
# d'ambiente definite: le variabili nginx ($host, $remote_addr, …) restano intatte.

# Risoluzione DNS dinamica degli upstream. Con un hostname fisso in proxy_pass
# nginx risolve il nome UNA volta all'avvio: se il container upstream viene
# ricreato (redeploy, restart) e cambia IP, nginx continua a puntare al vecchio
# IP → 502 "Host is unreachable" finché nginx non viene riavviato.
# Passando l'upstream tramite variabile il nome viene ri-risolto a runtime.
# NGINX_LOCAL_RESOLVERS è letto da /etc/resolv.conf dall'entrypoint ufficiale
# (15-local-resolvers.envsh): funziona sia con Docker (127.0.0.11) sia con
# Podman (aardvark-dns).
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

server {
    listen 80;

    # Senza URI nella variabile, proxy_pass inoltra la request URI originale
    # (stesso comportamento del vecchio proxy_pass con hostname fisso).
    set $config_api_upstream http://config-api:8000;
    set $satosa_upstream http://satosa:8080;

    # Admin UI → config-api
    location /admin {
        proxy_pass $config_api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Health check config-api
    location /health {
        proxy_pass $config_api_upstream;
    }

    # Shortcut: root well-known → CIE OIDC backend
    location = /.well-known/openid-federation {
        rewrite ^ /CieOidcRp/.well-known/openid-federation last;
    }

    # Suppress browser auto-request for favicon when not configured
    location = /favicon.ico {
        return 204;
        access_log off;
    }

    # robots.txt: proxy SSO senza contenuti indicizzabili, blocca tutto
    # (evita anche l'errore "not bound to any endpoint" loggato da satosa)
    location = /robots.txt {
        default_type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
        access_log off;
    }

    # Pagina pubblica verifica SPID (attiva solo con validator/demo IdP)
    location /verifica {
        proxy_pass $config_api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SATOSA OIDC/SAML endpoints
    location / {
        proxy_pass $satosa_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_buffer_size 16k;
        proxy_buffers 4 16k;
    }

    # Disable caching for json configurations
    location ~* \.json$ {
        proxy_pass $satosa_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        expires 0;
    }
}
