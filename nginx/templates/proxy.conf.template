# Template elaborato da /docker-entrypoint.d/20-envsubst-on-templates.sh
# → /etc/nginx/conf.d/proxy.conf. envsubst sostituisce solo le variabili
# d'ambiente definite: le variabili nginx ($host, $remote_addr, …) restano intatte.

# Risoluzione DNS dinamica degli upstream. Con un hostname fisso in proxy_pass
# nginx risolve il nome UNA volta all'avvio: se il container upstream viene
# ricreato (redeploy, restart) e cambia IP, nginx continua a puntare al vecchio
# IP → 502 "Host is unreachable" finché nginx non viene riavviato.
# Passando l'upstream tramite variabile il nome viene ri-risolto a runtime.
# NGINX_LOCAL_RESOLVERS è letto da /etc/resolv.conf dall'entrypoint ufficiale
# (15-local-resolvers.envsh): funziona sia con Docker (127.0.0.11) sia con
# Podman (aardvark-dns).
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

# Nessuna versione di nginx in header e pagine di errore.
server_tokens off;

# Rate limit per IP client (IP reale con NGINX_TRUSTED_PROXIES, 25-real-ip.sh).
#   admin_login  login admin + 2FA: rallenta brute force e enumerazione,
#                in aggiunta al ban applicativo di config-api.
#   sso          flussi SATOSA e /verifica: limite largo (la discovery carica
#                decine di asset, e gli uffici escono spesso da un solo IP NAT),
#                ferma solo il flood.
limit_req_zone $binary_remote_addr zone=admin_login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=sso:10m rate=30r/s;
limit_req_status 429;

server {
    # nginx-unprivileged: niente porte < 1024 senza root.
    listen 8080;

    # Senza URI nella variabile, proxy_pass inoltra la request URI originale
    # (stesso comportamento del vecchio proxy_pass con hostname fisso).
    set $config_api_upstream http://config-api:8000;
    set $satosa_upstream http://satosa:8080;

    # Admin UI → config-api.
    # CSP: script solo da file dell'origine (/admin/static/js/admin.js), nessun
    # JS inline nei template (test_csp_templates.py lo verifica): markup
    # iniettato non esegue codice. 'unsafe-inline' resta solo sugli stili
    # (attributi style nei template, non eseguono codice); connect/form/base/frame
    # impediscono di esfiltrare dati verso altre origini.
    # img-src https: per i loghi di ente e IdP (domini esterni).
    location ^~ /admin {
        include /etc/nginx/conf.d/admin-access.inc;
        proxy_pass $config_api_upstream;
        # $http_host (con porta), non $host: config-api confronta Origin con Host
        # (CSRF) e su una porta non standard $host la perde → login rifiutato.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'" always;
        add_header Cache-Control "no-store" always;
    }

    # Login admin e 2FA: stessa config di /admin più il rate limit.
    location ^~ /admin/login {
        limit_req zone=admin_login burst=10 nodelay;
        include /etc/nginx/conf.d/admin-access.inc;
        proxy_pass $config_api_upstream;
        # $http_host (con porta), non $host: config-api confronta Origin con Host
        # (CSRF) e su una porta non standard $host la perde → login rifiutato.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'" always;
        add_header Cache-Control "no-store" always;
    }

    # Health check config-api
    location /health {
        proxy_pass $config_api_upstream;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Shortcut: root well-known → CIE OIDC backend
    location = /.well-known/openid-federation {
        rewrite ^ /CieOidcRp/.well-known/openid-federation last;
    }

    # Suppress browser auto-request for favicon when not configured
    location = /favicon.ico {
        return 204;
        access_log off;
    }

    # robots.txt: proxy SSO senza contenuti indicizzabili, blocca tutto
    # (evita anche l'errore "not bound to any endpoint" loggato da satosa)
    location = /robots.txt {
        default_type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
        access_log off;
    }

    # Pagina pubblica verifica SPID (attiva solo con validator/demo IdP)
    # Font serviti da config-api (/verifica/static/fonts): nessuna richiesta a Google.
    location /verifica {
        limit_req zone=sso burst=200 nodelay;
        proxy_pass $config_api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'" always;
    }

    # SATOSA OIDC/SAML endpoints.
    # CSP minima: le pagine SAML fanno POST automatici verso IdP di domini
    # diversi (form-action non restringibile) e la discovery ha script inline.
    location / {
        limit_req zone=sso burst=200 nodelay;
        proxy_pass $satosa_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_buffer_size 16k;
        proxy_buffers 4 16k;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Security-Policy "frame-ancestors 'none'; base-uri 'none'; object-src 'none'" always;
    }

    # Disable caching for json configurations
    location ~* \.json$ {
        limit_req zone=sso burst=200 nodelay;
        proxy_pass $satosa_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Security-Policy "frame-ancestors 'none'; base-uri 'none'; object-src 'none'" always;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        expires 0;
    }
}
