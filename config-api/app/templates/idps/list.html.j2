{% extends "base.html.j2" %}
{% block title %}SPID — PA SSO Proxy{% endblock %}
{% block page_title %}SPID{% endblock %}

{% block topbar_actions %}
<div style="display:flex;gap:8px;align-items:center;">
  {% if proxy_hostname %}
  <a href="https://{{ proxy_hostname }}/spidSaml2/metadata" target="_blank" class="a-btn a-btn-secondary a-btn-sm">Metadata SP (AgID)</a>
  {% endif %}
  <form method="post" action="/admin/idps/enable-all" style="display:inline;">
    <button class="a-btn a-btn-neutral a-btn-sm">Abilita tutti</button>
  </form>
  <form method="post" action="/admin/idps/sync" style="display:inline;">
    <button class="a-btn a-btn-primary a-btn-sm">Sync da Registry</button>
  </form>
</div>
{% endblock %}

{% block content %}
{% if saved %}
<div class="a-alert a-alert-success" style="margin-bottom:16px;">Configurazione aggiornata. SATOSA ricaricato.</div>
{% endif %}

{# Tab bar: click cambia pannello visibile, pallino = stato sezione #}
<div class="a-tabs" role="tablist">
  <button type="button" class="a-tab" data-tab="spid" role="tab">
    <span class="a-tab-dot" style="background:{% if cert %}{% if (cert.not_valid_after - now).days < 30 %}var(--danger){% else %}var(--success){% endif %}{% else %}var(--danger){% endif %};"></span>
    SPID
  </button>
  <button type="button" class="a-tab" data-tab="test" role="tab">
    <span class="a-tab-dot" style="background:{% if test_provider_enabled %}var(--success){% else %}var(--fg-muted){% endif %};"></span>
    Test/Validazione
  </button>
  <button type="button" class="a-tab" data-tab="provider" role="tab">
    <span class="a-tab-dot" style="background:{% if registry_provider_enabled %}var(--success){% else %}var(--fg-muted){% endif %};"></span>
    Provider
  </button>
  <button type="button" class="a-tab" data-tab="eidas" role="tab">
    <span class="a-tab-dot" style="background:{% if s and s.eidas_enabled %}var(--success){% else %}var(--fg-muted){% endif %};"></span>
    eIDAS
  </button>
  <button type="button" class="a-tab" data-tab="persona-giuridica" role="tab">
    <span class="a-tab-dot" style="background:{% if s and s.legal_entity_enabled %}var(--success){% else %}var(--fg-muted){% endif %};"></span>
    Persona giuridica
  </button>
  <button type="button" class="a-tab" data-tab="gestione-metadata" role="tab">
    <span class="a-tab-dot" style="background:{% if uploaded_exposed %}var(--danger){% elif not profile.profile %}var(--fg-muted){% elif profile.matches %}var(--success){% else %}var(--warning){% endif %};"></span>
    Profilo validato
  </button>
</div>

<style>
.a-tabs { display:flex; gap:4px; margin-bottom:16px; border-bottom:1px solid var(--border-1); }
.a-tab { display:inline-flex; align-items:center; gap:8px; padding:10px 16px; font-size:13px; font-weight:600; color:var(--fg-muted); background:transparent; border:1px solid transparent; border-bottom:none; border-radius:6px 6px 0 0; cursor:pointer; }
.a-tab:hover { color:var(--fg-1); background:var(--bg-2); }
.a-tab.active { color:var(--fg-1); background:var(--bg-1); border-color:var(--border-1); }
.a-tab-dot { width:8px; height:8px; border-radius:50%; flex:none; }
.a-tab-panel[hidden] { display:none; }
.a-help { background:#E5F1FC; border:1px solid var(--brand); border-radius:6px; margin-bottom:16px; }
.a-help > summary { padding:10px 14px; font-size:13px; font-weight:600; color:var(--brand-dk); cursor:pointer; list-style:none; display:flex; align-items:center; gap:8px; }
.a-help > summary::-webkit-details-marker { display:none; }
.a-help > summary::before { content:"❓"; }
.a-help[open] > summary::before { content:"💡"; }
.a-help-body { padding:0 14px 14px 14px; font-size:13px; line-height:1.6; color:var(--brand-dk); }
.a-help-body p { margin:0 0 10px 0; }
.a-help-body ol, .a-help-body ul { margin:0 0 10px 0; padding-left:20px; }
.a-help-body li { margin-bottom:4px; }
.a-help-body code { background:rgba(0,0,0,0.06); padding:1px 4px; border-radius:3px; font-size:12px; }
.a-help-example { background:rgba(255,255,255,0.6); border-left:3px solid var(--brand); padding:10px 12px; border-radius:0 4px 4px 0; margin-top:8px; }
</style>

<section id="spid" class="a-tab-panel">
<details class="a-help">
  <summary>Come funziona questa sezione</summary>
  <div class="a-help-body">
    <p>Le <strong>chiavi</strong> sono la coppia certificato + chiave privata con cui il proxy firma e decifra i messaggi SAML verso gli Identity Provider SPID/eIDAS. Il certificato pubblico è quello registrato su AgID e negli IdP.</p>
    <p><strong>"Rigenera chiavi"</strong> crea una coppia completamente nuova: il certificato pubblico cambia per davvero. Da quel momento il metadata registrato su AgID non corrisponde più alla chiave che il proxy usa realmente — serve una nuova validazione/registrazione. È un'operazione diversa e più invasiva di "Rigenera metadata" (tab <em>Profilo validato</em>), che non tocca le chiavi.</p>
    <div class="a-help-example"><strong>Esempio:</strong> il certificato scade tra 20 giorni → rigeneri le chiavi → il metadata SP cambia contenuto (nuovo certificato) → va ri-registrato/ri-validato presso AgID prima che SPID torni a funzionare in produzione con gli IdP ufficiali.</div>
  </div>
</details>
{# Certificate section #}
<div class="a-card" style="margin-bottom:14px;">
    <div class="a-card-header">
      Chiavi di Firma SPID/eIDAS (SAML SP)
      <span class="a-badge a-badge-neutral">Certificato</span>
    </div>
    <div class="a-card-body">
      {% if cert_error %}<div class="a-alert a-alert-danger">{{ cert_error }}</div>{% endif %}
      {% if s and s.eidas_enabled and metadata_status and not metadata_status.has_eidas %}
        <div class="a-alert a-alert-warning" style="margin-bottom:16px;">
          <strong>Attenzione:</strong> eIDAS è abilitato in configurazione, ma il metadata pubblicato non supporta ancora eIDAS (indici FICEP 99/100 mancanti).
          Verifica che SATOSA sia stato ricaricato correttamente (nel tab Profilo validato trovi "Rigenera metadata").
        </div>
      {% endif %}
      {% if cert %}
        {% set days_left = (cert.not_valid_after - now).days %}
        {% if days_left < 30 %}
          <div class="a-alert a-alert-danger">Il certificato scade tra <strong>{{ days_left }} giorni</strong> ({{ cert.not_valid_after.strftime('%Y-%m-%d') }}).</div>
        {% elif days_left < 90 %}
          <div class="a-alert a-alert-warning">Il certificato scade tra <strong>{{ days_left }} giorni</strong> ({{ cert.not_valid_after.strftime('%Y-%m-%d') }}).</div>
        {% else %}
          <div class="a-alert a-alert-success">Certificato valido fino al <strong>{{ cert.not_valid_after.strftime('%Y-%m-%d') }}</strong> ({{ days_left }} giorni).</div>
        {% endif %}
        <div class="a-form-group">
          <label class="a-label">Subject DN</label>
          <input class="a-input a-input-ro" type="text" value="{{ cert.subject_dn }}" readonly>
        </div>
        <div class="a-muted" style="font-size:12px;margin-bottom:16px;">Generato il: <span class="a-mono">{{ cert.created_at.strftime('%Y-%m-%d %H:%M') }}</span></div>
        <form method="post" action="/admin/certs/generate" onsubmit="return confirmRegenCert()">
          <button type="submit" class="a-btn a-btn-secondary a-btn-sm">Rigenera chiavi</button>
        </form>
      {% else %}
        <div class="a-alert a-alert-warning" style="margin-bottom:16px;">Nessun certificato SPID configurato. Genera le chiavi per abilitare l'autenticazione SPID.</div>
        <form method="post" action="/admin/certs/generate">
          <button type="submit" class="a-btn a-btn-primary">Genera chiavi</button>
        </form>
      {% endif %}
        <a href="/admin/certs" class="a-link" style="font-size:13px;">Storico certificati &rarr;</a>
    </div>
</div>

{# SAML SP Metadata Status Card — SPID + eIDAS + persona giuridica insieme #}
<div class="a-card">
    <div class="a-card-header">
      Stato Metadata SAML (Service Provider)
      <span class="a-badge a-badge-neutral">SAML SP</span>
    </div>
    <div class="a-card-body">
      <p style="font-size:13px;margin-bottom:12px;color:var(--fg-muted);">
        Il proxy pubblica il proprio metadata SAML a questo URL pubblico, necessario per registrare il servizio presso AgID/IdP:
      </p>
      <div class="a-form-group" style="margin-bottom:12px;">
        <input class="a-input a-input-ro a-mono" type="text" value="https://{{ proxy_hostname }}/spidSaml2/metadata" readonly style="font-size:12px;">
      </div>

      {% if metadata_status %}
        {% if metadata_status.valid %}
          <div style="display:flex;flex-direction:column;gap:10px;margin-top:8px;">
            <div style="display:flex;align-items:center;gap:8px;">
              <span style="font-size:13px;font-weight:600;color:var(--fg-muted);">Supporto SPID:</span>
              {% if metadata_status.has_spid %}
                <span class="a-badge a-badge-success">Attivo</span>
              {% else %}
                <span class="a-badge a-badge-danger">Non configurato</span>
              {% endif %}
            </div>
            <div style="display:flex;align-items:center;gap:8px;">
              <span style="font-size:13px;font-weight:600;color:var(--fg-muted);">Supporto eIDAS (FICEP):</span>
              {% if metadata_status.has_eidas %}
                <span class="a-badge a-badge-success">Attivo (indici 99/100 presenti)</span>
              {% else %}
                <span class="a-badge a-badge-neutral">Non attivo</span>
              {% endif %}
            </div>
            {% if legal_entity_metadata_status and legal_entity_metadata_status.valid %}
            <div style="display:flex;align-items:center;gap:8px;">
              <span style="font-size:13px;font-weight:600;color:var(--fg-muted);">Supporto persona giuridica:</span>
              {% if legal_entity_metadata_status.has_company_attributes %}
                <span class="a-badge a-badge-success">Attributi azienda dichiarati</span>
              {% else %}
                <span class="a-badge a-badge-neutral">Non dichiarati</span>
              {% endif %}
            </div>
            {% endif %}
          </div>
        {% else %}
          <div class="a-alert a-alert-danger" style="margin-top:8px;">
            <strong>Impossibile verificare lo stato del metadata locale:</strong> {{ metadata_status.error }}
          </div>
        {% endif %}
      {% else %}
        <div class="a-muted" style="font-size:12px;">Verifica in corso...</div>
      {% endif %}
    </div>
</div>
</section>

<section id="test" class="a-tab-panel" hidden>
<details class="a-help">
  <summary>Come funziona questa sezione</summary>
  <div class="a-help-body">
    <p><strong>Demo</strong> e <strong>Validator</strong> sono i due IdP ufficiali AgID per test/collaudo (nessun cittadino reale). Sono mutuamente esclusivi: attivarne uno disattiva automaticamente l'altro.</p>
    <p>Attivarli/disattivarli <strong>non modifica il metadata SP</strong> — cambia solo quali IdP compaiono nella pagina di scelta provider. Nessun impatto sulla validazione AgID.</p>
    <p><strong>Dove compaiono.</strong> Sempre nel login partito da <code>/verifica</code>; negli applicativi solo per i client OIDC con <em>Consenti IdP di test</em> attivo (Client OIDC → Modifica), utile per collaudare un'app col Demo. Per tutti gli altri client sono nascosti e rifiutati anche aprendo a mano l'URL di login: accettano identità inventate.</p>
    <div class="a-help-example"><strong>Esempio:</strong> attivi il Validator, mandi il link <code>/verifica</code> ad AgID per la sessione di collaudo, poi lo disattivi — in nessun momento serve toccare chiavi o metadata.</div>
  </div>
</details>
{# Test/Validation providers #}
<div class="a-card">
  <div class="a-card-header">
    Ambiente di Test / Validazione
    <span class="a-badge-spid">SPID SAML</span>
  </div>
  <div class="a-card-body">
    <div class="a-muted" style="margin-bottom:16px;font-size:13px;">
      Attiva uno dei provider di test/validazione per effettuare l'integrazione o il collaudo del proxy.
      <strong>Solo un provider alla volta può essere attivo.</strong>
    </div>
    <div class="a-grid-2">
      {# Demo Provider #}
      <div class="a-card" style="{% if demo_idp and demo_idp.enabled %}border-color: var(--success);{% endif %}">
        <div class="a-card-header">
          SPID Demo Provider
          {% if demo_idp and demo_idp.enabled %}
            <span class="a-badge a-badge-success">Attivo</span>
          {% else %}
            <span class="a-badge a-badge-neutral">Inattivo</span>
          {% endif %}
        </div>
        <div class="a-card-body">
          <p style="font-size:13px;color:var(--fg-muted);margin-bottom:12px;">Permette l'autenticazione tramite il provider di demo ufficiale di SPID.</p>
          <code class="a-mono" style="display:block;word-break:break-all;font-size:11px;margin-bottom:16px;">{{ demo_idp.metadata_url if demo_idp else 'https://demo.spid.gov.it/metadata.xml' }}</code>
          {% if demo_idp %}
          <form method="post" action="/admin/idps/{{ demo_idp.id }}/toggle">
            <button type="submit" class="a-btn {% if demo_idp.enabled %}a-btn-danger{% else %}a-btn-primary{% endif %} a-btn-sm" style="width:100%;justify-content:center;">
              {% if demo_idp.enabled %}Disattiva Demo{% else %}Attiva Demo{% endif %}
            </button>
          </form>
          <div style="margin-top: 12px; text-align: center;">
            <a href="/verifica" target="_blank" style="font-size: 12px; font-weight: 600; color: #0056b3; text-decoration: underline;">Apri Pagina di Verifica &rarr;</a>
          </div>
          {% else %}
          <button class="a-btn a-btn-neutral a-btn-sm" style="width:100%;" disabled>In caricamento...</button>
          {% endif %}
        </div>
      </div>

      {# Validator #}
      <div class="a-card" style="{% if validator_idp and validator_idp.enabled %}border-color: var(--success);{% endif %}">
        <div class="a-card-header">
          Validator AgID
          {% if validator_idp and validator_idp.enabled %}
            <span class="a-badge a-badge-success">Attivo</span>
          {% else %}
            <span class="a-badge a-badge-neutral">Inattivo</span>
          {% endif %}
        </div>
        <div class="a-card-body">
          <p style="font-size:13px;color:var(--fg-muted);margin-bottom:12px;">Permette di verificare la conformità del proxy tramite il validatore ufficiale di AgID.</p>
          <code class="a-mono" style="display:block;word-break:break-all;font-size:11px;margin-bottom:16px;">{{ validator_idp.metadata_url if validator_idp else 'https://validator.spid.gov.it/metadata.xml' }}</code>
          {% if validator_idp %}
          <form method="post" action="/admin/idps/{{ validator_idp.id }}/toggle">
            <button type="submit" class="a-btn {% if validator_idp.enabled %}a-btn-danger{% else %}a-btn-primary{% endif %} a-btn-sm" style="width:100%;justify-content:center;">
              {% if validator_idp.enabled %}Disattiva Validatore{% else %}Attiva Validatore{% endif %}
            </button>
          </form>
          <div style="margin-top: 12px; text-align: center;">
            <a href="/verifica" target="_blank" style="font-size: 12px; font-weight: 600; color: #0056b3; text-decoration: underline;">Apri Pagina di Verifica &rarr;</a>
          </div>
          {% else %}
          <button class="a-btn a-btn-neutral a-btn-sm" style="width:100%;" disabled>In caricamento...</button>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>
</section>

<section id="provider" class="a-tab-panel" hidden>
<details class="a-help">
  <summary>Come funziona questa sezione</summary>
  <div class="a-help-body">
    <p>Lista degli IdP SPID di produzione, sincronizzata dal registry ufficiale AgID (automaticamente ogni 6 ore, o a mano con "Sync da Registry"). Abilitare/disabilitare un IdP decide solo se compare come opzione di login per i cittadini.</p>
    <p>Questa sezione <strong>non tocca il metadata SP del proxy</strong> — cambia quali IdP il proxy contatta, non cosa il proxy dichiara di sé stesso. Nessun impatto su AgID/validazione.</p>
  </div>
</details>
{# Registry sync + IdP table #}
<div class="a-card">
  <div class="a-card-header">
    <div>
      <div>Registry SPID</div>
      <div class="a-muted" style="font-size:11px;font-weight:400;">Lista locale sincronizzata giornalmente dal registry AgID.</div>
    </div>
    <div class="a-muted" style="font-size:12px;text-align:right;">
      <div>Ultima sync DB</div>
      <div class="a-mono">{{ last_sync_at.strftime('%d/%m/%Y %H:%M') if last_sync_at else '—' }}</div>
    </div>
  </div>
  {% if sync_status == 'ok' %}
  <div style="padding:8px 20px;border-bottom:1px solid var(--border-1);">
    <div class="a-alert a-alert-success" style="margin-bottom:0;">Sync completata. Nuovi IdP inseriti: {{ sync_inserted or '0' }}.</div>
  </div>
  {% elif sync_status == 'error' %}
  <div style="padding:8px 20px;border-bottom:1px solid var(--border-1);">
    <div class="a-alert a-alert-warning" style="margin-bottom:0;">Sync non riuscita ({{ sync_error or 'errore sconosciuto' }}).</div>
  </div>
  {% endif %}
  {% if idps %}
  <div class="a-table-wrap">
    <table class="a-table">
      <thead>
        <tr>
          <th>Logo</th>
          <th>Entity ID</th>
          <th>Organization</th>
          <th>Aggiornato</th>
          <th>Sync</th>
          <th>Abilitato</th>
          <th>Dettagli</th>
        </tr>
      </thead>
      <tbody>
        {% for item in idps %}
        <tr>
          <td style="width:72px;">
            {% if item.registry_logo_uri %}
            <img src="{{ item.registry_logo_uri }}" alt="{{ item.registry_organization_name or item.registry_entity_id }}" style="max-height:32px;max-width:64px;object-fit:contain;">
            {% else %}
            <span class="a-muted">—</span>
            {% endif %}
          </td>
          <td><code class="a-mono" style="font-size:11px;word-break:break-all;">{{ item.registry_entity_id or '—' }}</code></td>
          <td>{{ item.registry_organization_name or item.display_name or '—' }}</td>
          <td class="a-mono a-muted" style="font-size:11px;">{{ item.registry_lastupdate_date or '—' }}</td>
          <td class="a-mono a-muted" style="font-size:11px;">{{ item.registry_synced_at.strftime('%d/%m/%Y %H:%M') if item.registry_synced_at else '—' }}</td>
          <td>
            <form method="post" action="/admin/idps/{{ item.id }}/toggle" style="display:inline;">
              {% if item.enabled %}
              <button type="submit" class="a-btn a-btn-sm" style="background:var(--success-bg);color:var(--success);border:1px solid var(--success);" title="Clicca per disabilitare">✓ Sì</button>
              {% else %}
              <button type="submit" class="a-btn a-btn-neutral a-btn-sm" title="Clicca per abilitare">No</button>
              {% endif %}
            </form>
          </td>
          <td>
            <a class="a-btn a-btn-secondary a-btn-sm" href="/admin/idps/detail?entity_id={{ item.registry_entity_id | urlencode }}">Dettagli</a>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <div class="a-card-body a-muted" style="font-size:13px;">Nessun IdP sincronizzato dal registry.</div>
  {% endif %}
</div>
</section>

<section id="eidas" class="a-tab-panel" hidden>
<details class="a-help">
  <summary>Come funziona questa sezione</summary>
  <div class="a-help-body">
    <p>Abilitare eIDAS aggiunge due nuovi indici (99 e 100) di <code>AttributeConsumingService</code> al metadata SP — il documento pubblicato <strong>cambia contenuto per davvero</strong>. Non tocca le chiavi, ma modifica cosa il metadata dichiara.</p>
    <p>Serve ri-validazione AgID prima di andare in produzione. <strong>Non serve rifarla ogni volta</strong> che riavvii SATOSA: solo la prima volta che abiliti/disabiliti (o cambi ambiente prod/QA).</p>
    <p><strong>L'accesso SPID già validato continua a funzionare</strong> anche prima della ri-validazione: gli ACS 99/100 si aggiungono a quelli esistenti. <strong>eIDAS invece funziona solo dopo l'aggiornamento del metadata sul registro AgID.</strong></p>
    <div class="a-help-example"><strong>Workflow consigliato per non rischiare nulla:</strong> abilita eIDAS qui e fai i test → se qualcosa non va, tab <em>Profilo validato</em> → <code>Ripristina validato</code> (torni esattamente alla configurazione validata) → quando AgID ha aggiornato il registro, <code>Segna validato</code>.</div>
  </div>
</details>
<div class="a-card" style="max-width:720px;">
  <div class="a-card-header">
    Integrazione eIDAS
    {% if s and s.eidas_enabled %}
    <span class="a-badge a-badge-success">abilitato</span>
    {% else %}
    <span class="a-badge a-badge-neutral">disabilitato</span>
    {% endif %}
  </div>
  <div class="a-card-body">
    {% if eidas_warning %}
    <div class="a-alert a-alert-warning" style="margin-bottom:16px;">
      Conferma l'abilitazione dal toggle qui sotto — modifica il metadata SP pubblicato e richiede ri-validazione AgID.
      L'accesso SPID già validato continua a funzionare; eIDAS funziona solo dopo l'aggiornamento del metadata sul registro AgID.
    </div>
    {% endif %}
    <p style="font-size:13px;margin-bottom:20px;color:var(--fg-muted);">
      Permette l'autenticazione di cittadini europei tramite il Nodo eIDAS Italiano (FICEP / AgID).
    </p>

    <form method="post" action="/admin/eidas/toggle" id="eidas-form" onsubmit="return handleEidasSubmit(event)">
      <input type="hidden" name="confirmed" id="eidas-confirmed" value="no">

      <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
        <label class="a-toggle">
          <input type="checkbox" name="eidas_enabled" id="eidas-enabled" value="yes" {% if s and s.eidas_enabled %}checked{% endif %}>
          <span class="a-toggle-slider"></span>
        </label>
        <span style="font-weight:600;font-size:14px;color:var(--fg-1);user-select:none;">Abilita Integrazione eIDAS</span>
      </div>

      <div class="a-form-group">
        <label class="a-label" for="eidas-env">Ambiente di esercizio</label>
        <select name="environment" id="eidas-env" class="a-select" style="max-width:300px;">
          <option value="prod" {% if s and s.eidas_environment == 'prod' %}selected{% endif %}>Produzione (PROD)</option>
          <option value="qa" {% if s and s.eidas_environment == 'qa' %}selected{% endif %}>Pre-produzione (QA)</option>
        </select>
        <div class="a-form-hint">Seleziona l'ambiente del gateway eIDAS italiano gestito da AgID.</div>
      </div>

      <div style="margin-top:24px;">
        <button type="submit" class="a-btn a-btn-primary">Salva configurazione</button>
      </div>
    </form>
  </div>
</div>
</section>

<section id="persona-giuridica" class="a-tab-panel" hidden>
<details class="a-help">
  <summary>Come funziona questa sezione</summary>
  <div class="a-help-body">
    <p>Abilitare l'accesso persona giuridica aggiunge un <code>AttributeConsumingService</code> dedicato con gli attributi azienda (ragione sociale, sede legale, P.IVA) al metadata SP — il documento pubblicato <strong>cambia contenuto per davvero</strong>, stessa logica di eIDAS.</p>
    <p>Serve ri-validazione AgID. Stesso workflow non distruttivo di eIDAS: vedi il suggerimento nel tab <em>Profilo validato</em>.</p>
    <p><strong>Persona fisica continua a funzionare</strong> anche prima della ri-validazione (usa l'ACS già registrato). <strong>Persona giuridica invece funziona solo dopo l'aggiornamento del metadata sul registro AgID</strong>: gli IdP leggono il metadata registrato, non quello pubblicato dal proxy, e senza l'ACS dedicato rifiutano la richiesta.</p>
  </div>
</details>
<div class="a-card" style="max-width:720px;">
  <div class="a-card-header">
    Accesso SPID persona giuridica
    {% if s and s.legal_entity_enabled %}
    <span class="a-badge a-badge-success">abilitato</span>
    {% else %}
    <span class="a-badge a-badge-neutral">disabilitato</span>
    {% endif %}
  </div>
  <div class="a-card-body">
    {% if legal_entity_warning %}
    <div class="a-alert a-alert-warning" style="margin-bottom:16px;">
      Conferma l'abilitazione dal toggle qui sotto — modifica il metadata SP pubblicato e richiede ri-validazione AgID.
      Persona fisica continua a funzionare; persona giuridica funziona solo dopo l'aggiornamento del metadata sul registro AgID.
    </div>
    {% endif %}
    <p style="font-size:13px;margin-bottom:20px;color:var(--fg-muted);">
      Permette l'autenticazione SPID Tipo 4 ("uso professionale per la persona giuridica")
      per i client OIDC che richiedono esplicitamente lo scope <code>legal_entity</code>.
      Aggiunge gli attributi azienda (ragione sociale, sede legale, codice fiscale/P.IVA)
      al metadata SP pubblicato.
    </p>

    <form method="post" action="/admin/legal-entity/toggle" id="legal-entity-form" onsubmit="return handleLegalEntitySubmit(event)">
      <input type="hidden" name="confirmed" id="legal-entity-confirmed" value="no">

      <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
        <label class="a-toggle">
          <input type="checkbox" name="legal_entity_enabled" id="legal-entity-enabled" value="yes" {% if s and s.legal_entity_enabled %}checked{% endif %}>
          <span class="a-toggle-slider"></span>
        </label>
        <span style="font-weight:600;font-size:14px;color:var(--fg-1);user-select:none;">Abilita accesso persona giuridica</span>
      </div>

      <div style="margin-top:24px;">
        <button type="submit" class="a-btn a-btn-primary">Salva configurazione</button>
      </div>
    </form>
  </div>
</div>
</section>

<section id="gestione-metadata" class="a-tab-panel" hidden>
<details class="a-help">
  <summary>Come funziona questa sezione</summary>
  <div class="a-help-body">
    <p><strong>Cosa conta per AgID.</strong> Gli IdP leggono il metadata SP dal registro AgID, non da questo proxy. "Validato" vuol dire che il proxy si comporta come il documento registrato: stesso entity ID, stesso certificato, stessi ACS e attributi (eIDAS, persona giuridica), stessi dati ente e contatti.</p>
    <p><strong>Il profilo validato è la configurazione, non un file.</strong> "Segna validato" fotografa i parametri attuali che finiscono nel metadata: certificato, dati ente/contatti, toggle eIDAS (con ambiente) e persona giuridica. Da quel momento la sezione segnala ogni differenza tra configurazione attuale e validata.</p>
    <p><strong>"Ripristina validato"</strong> riapplica quei parametri e SATOSA rigenera il metadata: torni esattamente alla configurazione validata. Se il profilo usa un certificato diverso da quello attivo, il ripristino lo riattiva solo dopo una conferma esplicita.</p>
    <div class="a-help-example">
      <strong>Esempio — provare eIDAS senza rischi:</strong>
      <ol>
        <li>Profilo validato: eIDAS spento. Stato "Uguale al validato".</li>
        <li>Abiliti eIDAS (tab eIDAS): lo stato diventa "Diverso dal validato — eIDAS: on (validato: off)". Fai i test.</li>
        <li>Non va? "Ripristina validato": eIDAS torna spento, metadata come prima.</li>
        <li>Va, e AgID ha aggiornato il registro? "Segna validato": il profilo nuovo diventa il validato, il precedente resta in archivio (ripristinabile).</li>
      </ol>
    </div>
    <p><strong>Storico metadata generati:</strong> una riga ogni volta che il contenuto del metadata cambia davvero. L'impronta ignora firma, ID e prefissi XML: riavvii e nuove versioni dell'immagine che non cambiano il contenuto non creano righe. È un registro, non un elenco di versioni da pubblicare.</p>
    <p><strong>Metadata caricato a mano:</strong> solo per emergenza. "Esponi" lo pubblica al posto di quello generato e da lì nessuna modifica di configurazione viene pubblicata finché non torni al metadata generato.</p>
  </div>
</details>

{% if metadata_error %}<div class="a-alert a-alert-danger">{{ metadata_error }}</div>{% endif %}
{% if metadata_warning %}<div class="a-alert a-alert-warning">{{ metadata_warning }}</div>{% endif %}
{% if metadata_info %}<div class="a-alert a-alert-success">{{ metadata_info }}</div>{% endif %}

{% if uploaded_exposed %}
<div class="a-alert a-alert-danger" style="display:flex;justify-content:space-between;align-items:center;gap:12px;">
  <div>Il metadata pubblicato è un <strong>file caricato a mano</strong> (riga #{{ uploaded_exposed.id }}): le modifiche di configurazione <strong>non</strong> vengono pubblicate.</div>
  <form method="post" action="/admin/metadata/override/clear" onsubmit="return confirm('Tornare al metadata generato da SATOSA?');">
    <button type="submit" class="a-btn a-btn-secondary a-btn-sm">Torna al metadata generato</button>
  </form>
</div>
{% endif %}

<div class="a-card">
  <div class="a-card-header">
    Profilo validato AgID
    {% if not profile.profile %}
      <span class="a-badge a-badge-neutral">Nessun profilo</span>
    {% elif profile.matches %}
      <span class="a-badge a-badge-success">Uguale al validato</span>
    {% else %}
      <span class="a-badge a-badge-warning">Diverso dal validato</span>
    {% endif %}
  </div>
  <div class="a-card-body">
    {% if not profile.profile %}
      <p class="a-muted" style="font-size:13px;">Nessuna configurazione segnata come validata. Quando AgID ha validato il metadata attuale, segnalo qui: potrai sempre tornarci.</p>
    {% else %}
      {% set p = profile.profile %}
      <div style="font-size:13px;margin-bottom:12px;">
        {% if p.label %}<strong>{{ p.label }}</strong> · {% endif %}segnato il {{ p.created_at.strftime('%d/%m/%Y %H:%M') if p.created_at else '—' }}
        · cert {% if p.cert_id %}#{{ p.cert_id }}{% else %}<span class="a-muted">non più presente</span>{% endif %}
        · eIDAS {{ 'on' if p.eidas_enabled else 'off' }}{% if p.eidas_enabled %} ({{ p.eidas_environment }}){% endif %}
        · PG {{ 'on' if p.legal_entity_enabled else 'off' }}
      </div>
      {% if profile.differences %}
      <div class="a-table-wrap" style="margin-bottom:12px;">
        <table class="a-table">
          <thead><tr><th>Parametro</th><th>Attuale</th><th>Validato</th></tr></thead>
          <tbody>
            {% for d in profile.differences %}
            <tr><td>{{ d.label }}</td><td class="a-mono" style="font-size:12px;">{{ d.current }}</td><td class="a-mono" style="font-size:12px;">{{ d.validated }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}
      {% if profile.document_matches is false and not profile.differences %}
      <div class="a-alert a-alert-warning">Parametri uguali al validato ma metadata diverso: probabilmente una nuova versione del proxy ha cambiato il documento. Confrontalo (Scarica XML) con quello validato prima di modificare il registro AgID.</div>
      {% endif %}
      {% if profile.entity_id_differs %}
      <div class="a-alert a-alert-danger">L'entity ID dipende da <code>PROXY_HOSTNAME</code>/<code>PROXY_BASE_URL</code> dello stack: non si ripristina da qui.</div>
      {% endif %}
      {% if not profile.matches %}
      <form method="post" action="/admin/metadata/profile/{{ p.id }}/restore" style="display:inline;"
            onsubmit="return confirmRestore(this, {{ 'true' if profile.differences | selectattr('label', 'equalto', 'Certificato') | list else 'false' }}, '{{ p.cert_id or '' }}');">
        <input type="hidden" name="confirm_cert" value="">
        <button type="submit" class="a-btn a-btn-primary a-btn-sm">Ripristina validato</button>
      </form>
      {% endif %}
    {% endif %}
    <form method="post" action="/admin/metadata/profile/validate" style="display:flex;gap:8px;align-items:center;margin-top:12px;flex-wrap:wrap;"
          onsubmit="return confirm('Segnare la configurazione ATTUALE come validata da AgID?{% if profile.profile %} Il profilo validato di oggi va in archivio.{% endif %}');">
      <input type="text" name="label" class="a-input" placeholder="Nota (es. validazione AgID 2026-11)" style="max-width:320px;">
      <button type="submit" class="a-btn a-btn-secondary a-btn-sm">Segna validato (configurazione attuale)</button>
    </form>
  </div>
</div>

{% if archived_profiles %}
<div class="a-card">
  <div class="a-card-header">Profili archiviati</div>
  <div class="a-table-wrap">
    <table class="a-table">
      <thead><tr><th>Segnato il</th><th>Nota</th><th>Cert</th><th>eIDAS / PG</th><th>Azioni</th></tr></thead>
      <tbody>
        {% for a in archived_profiles %}
        <tr>
          <td>{{ a.created_at.strftime('%Y-%m-%d %H:%M') if a.created_at else '—' }}</td>
          <td>{{ a.label or '—' }}</td>
          <td>{% if a.cert_id %}#{{ a.cert_id }}{% else %}<span class="a-muted">non più presente</span>{% endif %}</td>
          <td style="font-size:11px;white-space:nowrap;">
            <span class="a-badge {{ 'a-badge-success' if a.eidas_enabled else 'a-badge-neutral' }}" style="font-size:10px;">eIDAS {{ 'on' if a.eidas_enabled else 'off' }}</span>
            <span class="a-badge {{ 'a-badge-success' if a.legal_entity_enabled else 'a-badge-neutral' }}" style="font-size:10px;">PG {{ 'on' if a.legal_entity_enabled else 'off' }}</span>
          </td>
          <td>
            <form method="post" action="/admin/metadata/profile/{{ a.id }}/restore" style="display:inline;"
                  onsubmit="return confirmRestore(this, {{ 'true' if a.cert_id and (not cert or a.cert_id != cert.id) else 'false' }}, '{{ a.cert_id or '' }}');">
              <input type="hidden" name="confirm_cert" value="">
              <button type="submit" class="a-btn a-btn-secondary a-btn-sm">Ripristina</button>
            </form>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endif %}

<div class="a-card">
  <div class="a-card-header">
    Storico metadata
    <span class="a-badge a-badge-neutral">SAML SP</span>
  </div>
  <div class="a-card-body">
    <div style="display:flex;gap:24px;flex-wrap:wrap;margin-bottom:20px;">
      <form method="post" action="/admin/metadata/upload" enctype="multipart/form-data">
        <div class="a-form-group">
          <label class="a-label">Carica metadata XML manuale (emergenza)</label>
          <input type="file" name="file" accept=".xml" class="a-input">
        </div>
        <button type="submit" class="a-btn a-btn-secondary">Carica</button>
      </form>
      <form method="post" action="/admin/metadata/regenerate">
        <div class="a-form-group">
          <label class="a-label">Metadata disallineato dal certificato attivo?</label>
          <div class="a-form-hint" style="margin-bottom:8px;">Forza un reload SATOSA senza toccare le chiavi.</div>
        </div>
        <button type="submit" class="a-btn a-btn-secondary">Rigenera metadata</button>
      </form>
    </div>

    {% if not metadata_versions %}
    <div class="a-alert a-alert-warning">Nessuna versione di metadata storicizzata ancora.</div>
    {% else %}
    {% set latest_generated_id = profile.latest_version.id if profile.latest_version else none %}
    {% set validated_hash = profile.profile.content_hash if profile.profile else none %}
    <div class="a-table-wrap">
    <table class="a-table">
      <thead>
        <tr><th>Fonte</th><th>Generato il</th><th>Cert</th><th>eIDAS / PG</th><th>Impronta</th><th>Stato</th><th>Azioni</th></tr>
      </thead>
      <tbody>
        {% for v in metadata_versions %}
        <tr>
          <td>{{ "Generato" if v.source == "generated" else "Caricato" }}</td>
          <td>{{ v.created_at.strftime('%Y-%m-%d %H:%M') if v.created_at else '—' }}</td>
          <td>{% if v.cert_id %}#{{ v.cert_id }}{% else %}—{% endif %}</td>
          <td style="font-size:11px;white-space:nowrap;">
            {% if v.eidas_enabled is none and v.legal_entity_enabled is none %}
              <span class="a-muted">—</span>
            {% else %}
              <span class="a-badge {{ 'a-badge-success' if v.eidas_enabled else 'a-badge-neutral' }}" style="font-size:10px;">eIDAS {{ 'on' if v.eidas_enabled else 'off' }}</span>
              <span class="a-badge {{ 'a-badge-success' if v.legal_entity_enabled else 'a-badge-neutral' }}" style="font-size:10px;">PG {{ 'on' if v.legal_entity_enabled else 'off' }}</span>
            {% endif %}
          </td>
          <td class="a-mono" style="font-size:11px;">{{ v.content_hash[:12] }}</td>
          <td>
            {% if v.is_exposed %}<span class="a-badge a-badge-danger">Pubblicato (manuale)</span>
            {% elif v.id == latest_generated_id and not uploaded_exposed %}<span class="a-badge a-badge-success">Pubblicato</span>{% endif %}
            {% if validated_hash and v.content_hash == validated_hash %}<span class="a-badge a-badge-secondary">= validato</span>{% endif %}
          </td>
          <td>
            {% if v.source == "uploaded" and not v.is_exposed %}
            <form method="post" action="/admin/metadata/{{ v.id }}/expose" style="display:inline;" onsubmit="return confirm('Pubblicare questo file al posto del metadata generato? Finché resta pubblicato, le modifiche di configurazione non vengono pubblicate.');">
              <button type="submit" class="a-btn a-btn-secondary a-btn-sm">Esponi</button>
            </form>
            {% endif %}
            <a href="/admin/metadata/{{ v.id }}/download" class="a-btn a-btn-secondary a-btn-sm">Scarica XML</a>
            {% if not v.is_exposed and v.id != latest_generated_id %}
            <form method="post" action="/admin/metadata/{{ v.id }}/delete" style="display:inline;" onsubmit="return confirm('Eliminare questa versione?');">
              <button type="submit" class="a-btn a-btn-danger a-btn-sm">Elimina</button>
            </form>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
    {% endif %}
  </div>
</div>
</section>

<script>
(function () {
  var tabs = document.querySelectorAll(".a-tab");
  var panels = document.querySelectorAll(".a-tab-panel");
  var validTabs = Array.prototype.map.call(tabs, function (t) { return t.dataset.tab; });

  function activate(name) {
    if (validTabs.indexOf(name) === -1) name = "spid";
    tabs.forEach(function (t) { t.classList.toggle("active", t.dataset.tab === name); });
    panels.forEach(function (p) { p.hidden = p.id !== name; });
  }

  tabs.forEach(function (t) {
    t.addEventListener("click", function () {
      history.replaceState(null, "", "#" + t.dataset.tab);
      activate(t.dataset.tab);
    });
  });

  activate((window.location.hash || "#spid").slice(1));
})();

const eidasInitialEnabled = {% if s and s.eidas_enabled %}true{% else %}false{% endif %};
const legalEntityInitialEnabled = {% if s and s.legal_entity_enabled %}true{% else %}false{% endif %};

function handleEidasSubmit(event) {
  var isEnabled = document.getElementById("eidas-enabled").checked;
  var envSelect = document.getElementById("eidas-env");
  var envLabel = envSelect.options[envSelect.selectedIndex].text;
  var confirmedInput = document.getElementById("eidas-confirmed");

  if (isEnabled && !eidasInitialEnabled) {
    var ok = window.confirm(
      "Abilitare l'integrazione eIDAS in ambiente " + envLabel + "?\n\n" +
      "Questo renderà visibile il pulsante di login eIDAS sulla pagina di scelta provider " +
      "e modifica il metadata SP pubblicato (richiede ri-validazione AgID).\n\n" +
      "L'accesso SPID già validato continua a funzionare; eIDAS funziona solo " +
      "dopo l'aggiornamento del metadata sul registro AgID."
    );
    if (!ok) { event.preventDefault(); return false; }
    confirmedInput.value = "yes";
  } else if (!isEnabled && eidasInitialEnabled) {
    var ok = window.confirm(
      "Disabilitare l'integrazione eIDAS?\n\n" +
      "Questo nasconderà il pulsante di login eIDAS dalla pagina di scelta provider."
    );
    if (!ok) { event.preventDefault(); return false; }
    confirmedInput.value = "yes";
  } else {
    confirmedInput.value = "yes";
  }
  return true;
}

function handleLegalEntitySubmit(event) {
  var isEnabled = document.getElementById("legal-entity-enabled").checked;
  var confirmedInput = document.getElementById("legal-entity-confirmed");

  if (isEnabled && !legalEntityInitialEnabled) {
    var ok = window.confirm(
      "Abilitare l'accesso SPID persona giuridica?\n\n" +
      "Questo modifica il metadata SP pubblicato (nuovi attributi opzionali azienda) " +
      "e richiede ri-validazione presso AgID.\n\n" +
      "Persona fisica continua a funzionare; persona giuridica funziona solo " +
      "dopo l'aggiornamento del metadata sul registro AgID."
    );
    if (!ok) { event.preventDefault(); return false; }
    confirmedInput.value = "yes";
  } else if (!isEnabled && legalEntityInitialEnabled) {
    var ok = window.confirm("Disabilitare l'accesso SPID persona giuridica?");
    if (!ok) { event.preventDefault(); return false; }
    confirmedInput.value = "yes";
  } else {
    confirmedInput.value = "yes";
  }
  return true;
}

function confirmRestore(form, certChange, certId) {
  var msg = "Ripristinare la configurazione del profilo? SATOSA rigenera il metadata.";
  if (certChange) {
    msg += "\n\nATTENZIONE: il profilo usa il certificato #" + certId + ", diverso da quello attivo. " +
      "Verrà riattivato: la firma delle richieste SPID tornerà a quella chiave.";
  }
  if (!window.confirm(msg)) return false;
  if (certChange) form.querySelector("input[name=confirm_cert]").value = "yes";
  return true;
}

function confirmRegenCert() {
  return window.confirm(
    "ATTENZIONE: La rigenerazione delle chiavi genera un nuovo certificato e una nuova chiave privata.\n\n" +
    "Questo invaliderà immediatamente il metadata SAML precedentemente registrato su AgID/FICEP e renderà impossibile l'autenticazione fino all'aggiornamento dei portali governativi.\n\n" +
    "Vuoi procedere?"
  );
}
</script>
{% endblock %}
