{% extends "base.html.j2" %}
{% block title %}Certificato SPID — PA SSO Proxy{% endblock %}
{% block page_title %}Certificato SPID{% endblock %}

{% block content %}
<div style="max-width:640px;">
  {% if error %}<div class="a-alert a-alert-danger">{{ error }}</div>{% endif %}

  {% if certs %}
    <table class="a-table" style="margin-top:16px;">
      <thead>
        <tr><th>Subject DN</th><th>Attivo</th><th>Scadenza</th><th>Generato il</th><th></th></tr>
      </thead>
      <tbody>
        {% for c in certs %}
        <tr>
          <td>{{ c.subject_dn }}</td>
          <td>{{ "Sì" if c.is_active else "No" }}</td>
          <td>{{ c.not_valid_after.strftime('%Y-%m-%d') }}</td>
          <td>{{ c.created_at.strftime('%Y-%m-%d %H:%M') if c.created_at else "" }}</td>
          <td>
            <a href="/admin/certs/{{ c.id }}/download/cert">cert</a>
            <a href="/admin/certs/{{ c.id }}/download/key">key</a>
            {% if not c.is_active %}
            <form method="post" action="/admin/certs/{{ c.id }}/activate" style="display:inline;">
              <button type="submit" class="a-btn a-btn-sm">Attiva</button>
            </form>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  {% else %}
  <div class="a-alert a-alert-warning">Nessun certificato SPID configurato. Configura le impostazioni ente e genera il certificato.</div>
  {% endif %}

  <form method="post" action="/admin/certs/generate" style="margin-top:20px;">
    <button type="submit" class="a-btn a-btn-primary">
      {% if cert %}Rigenera certificato{% else %}Genera certificato{% endif %}
    </button>
  </form>
</div>
{% endblock %}
